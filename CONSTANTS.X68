; =========================================================
; GAME AND BLOCKS CONSTANTS
; =========================================================
   
; - DRAWING IN GAME RELATED CONSTANTS ---------------------

LENGTH1		EQU 2		  ;
LENGTH2		EQU 13		  ;
BLOCK1PEN   EQU $00000000 ; 
BLOCK1FILL  EQU $009EA7B5 ; 
 
BLOCK2C0	EQU $00336699 ;
BLOCK2C1	EQU $00000000 ;
BLOCK2C2	EQU	$000E95FF ;

LLITPEN1    EQU $00052B56 ; 
LLITFILL1   EQU $00052B56 ; 

LLITPEN2    EQU $00FFFFFF ; 
LLITFILL2   EQU $00AAFFFF ;

LLITFILL3   EQU $000022FF ;

; - DRAWING TITLE SCREEN RELATED CONSTANTS ----------------

MHEADCOL 	EQU $00FFFFFF      ; MAIN HEADING COLOR
MHEADCOS 	EQU $00808080      ; MAIN HEADING COLOR SHADOW

S1COORD		EQU $0101          ; SUBHEADING1 COORD
S2COORD		EQU (((SCRWIDTH/16)-(22/2))<<8)|((SCRHEIGH/32)+(150/16))         ; SUBHEADING2 COORD

PILLRAD		EQU 10			   ; RADIUS OF THE PILL
PILXSPEED	EQU 3			   ; VELOCITY X OF THE PILL (MAGNITUDE)
PILYSPEED	EQU 3			   ; VELOCITY Y OF THE PILL (MAGNITUDE)
PILLXINIT	EQU 240			   ; INIT X OF THE PILL
PILLYINIT	EQU	262		   	   ; INIT Y OF THE PILL
PILXINITS	EQU 245			   ; INIT X OF THE PILL SHADOW
PILYINITS	EQU	267			   ; INIT Y OF THE PILL SHADOW

; - PLAYER RELATED CONSTANTS ------------------------------

PLAYERSZ	EQU 16			  ; PLAYER SIZE (16	 x	16)
PLWSPEED	EQU 3             ; PROVISIONAL WALKING SPEED
PLJUMP1		EQU 3			  ; PROVISIONAL JUMP1 POWER
PLJUMP2 	EQU 6			  ; PROVISIONAL JUMP2 POWER


















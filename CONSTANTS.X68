; =========================================================
; GAME AND BLOCKS CONSTANTS
; =========================================================
   
; - DRAWING IN GAME RELATED CONSTANTS ---------------------

LENGTH1		EQU 2		  ;
LENGTH2		EQU 13		  ;
BLOCK1PEN   EQU $00000000 ; 
BLOCK1FILL  EQU $009EA7B5 ; 
 
BLOCK2C0	EQU $00336699 ;
BLOCK2C1	EQU $00000000 ;
BLOCK2C2	EQU	$000E95FF ;

LLITPEN1    EQU $00052B56 ; 
LLITFILL1   EQU $00052B56 ; 

LLITPEN2    EQU $00FFFFFF ; 
LLITFILL2   EQU $00AAFFFF ;

LLITFILL3   EQU $000022FF ;

; - DRAWING START SCREEN RELATED CONSTANTS ----------------

BKGNDCOL	EQU $00FFFFFF	   ; BACKGROUND COLOR
MHEADCOL 	EQU $00000000      ; MAIN HEADING COLOR
SHEAD1		EQU $000000FF	   ; SUBHEADING 1 COLOR
SHEAD2		EQU $0000FF00	   ; SUBHEADING 2 COLOR

MIMHEIG		EQU 150			   ; MAIN HEADING IMG HEIGTH
MIMWIDT		EQU 13			   ; MAIN HEADING IMG WIDTH
MHCOORD		EQU	15			   ; MAINHEADING COORD
S1COORD		EQU $0101          ; SUBHEADING1 COORD
S2COORD		EQU (((SCRWIDTH/16)-(22/2))<<8)|((SCRHEIGH/32)+(MIMHEIG/32))         ; SUBHEADING2 COORD

; - PLAYER RELATED CONSTANTS ------------------------------

PLAYERSZ	EQU 16			  ; PLAYER SIZE (16	 x	16)
PLWSPEED	EQU 3             ; PROVISIONAL WALKING SPEED
PLJUMP1		EQU 3			  ; PROVISIONAL JUMP1 POWER
PLJUMP2 	EQU 6			  ; PROVISIONAL JUMP2 POWER















*-----------------------------------------------------------
* Title      :SPRITE
* Written by :
* Date       :
* Description:
*-----------------------------------------------------------
SPRITEDRAWING
			
			LEA BUFFER1,A0
			
			MOVE.W	(A0)+,D6	;IMAGE WIDTH
			MOVE.W	(A0)+,D7	;IMAGE HEIGHT
		
			
			MOVE.L	#0,D4		;D4 USED TO CONTROL CURRENT WIDTH
			MOVE.L	#0,D3		;D3 USED TO CONTROL CURRENT HEIGHT
			
HEIGHT		CMP.W D7,D3
			BHS FINAL						
			MOVE.L	#0,D4		;D4 USED TO CONTROL CURRENT WIDTH

NEXT			
			MOVE.L	(A0)+,D0	;COLORS AND NUMBER OF REPETITIONS
			MOVE.L	D0,D1		;D1 GETS COLOR
			LSR.L	#8,D1		;BITS MOVED TO GET CORRECT FORMAT			
			MOVE.L	D0,D5		;D5 GETS REPETITIONS
			AND.L #$FF,D5		;MASK TO GET CORRECT FORMAT

			
			CLR D0
			MOVE.B #80,D0
			TRAP #15
			
PAINT

			MOVE.L D4,D1
			MOVE.L D3,D2 
			MOVE.B #82,D0
			TRAP #15
			ADDQ.L #1,D4
			DBRA D5,PAINT
			CMP.W D4,D6
			BEQ HEIGHT_CHECK
			BNE NEXT
HEIGHT_CHECK
			ADDQ.W #1,D3
			BRA	HEIGHT
			
FINAL  			RTS


SPRITEDRAWINGDEF

			LEA BUFFER1,A0
			MOVE.W	(A0)+,D6	;IMAGE WIDTH
			MOVE.W	(A0)+,D7	;IMAGE HEIGHT
		
			
			MOVE.L	#0,D4		;D4 USED TO CONTROL CURRENT WIDTH
			MOVE.L	#0,D3		;D3 USED TO CONTROL CURRENT HEIGHT
			
HEIGHT2		CMP.W D7,D3
			BHS FINAL2						
			MOVE.L	#0,D4		;D4 USED TO CONTROL CURRENT WIDTH

NEXT2			
			MOVE.L	(A0)+,D0	;COLORS AND NUMBER OF REPETITIONS
			MOVE.L	D0,D1		;D1 GETS COLOR
			LSR.L	#8,D1		;BITS MOVED TO GET CORRECT FORMAT			
			MOVE.L	D0,D5		;D5 GETS REPETITIONS
			AND.L #$FF,D5		;MASK TO GET CORRECT FORMAT

			CMP.L	#0,D1
			BEQ	NOPAINT
			CLR D0
			MOVE.B #80,D0
			TRAP #15
			MOVE.B #81,D0
			TRAP #15
			
		;NEEDED D1.W = LX, D2.W = UY, D3.W = RX, D4.W = LY
		
			MOVEM.L D3/D4/D5,-(A7)
			LSL #1,D4
				LSL #1,D3
			MOVE.L  D4,D1       
			MOVE.L  D3,D2      
			
			
			MOVE.L D4,D3 
			ADDQ.L	#1,D5
			LSL.L	#1,D5           
			ADD.L   D5,D3
			SUBQ.L	#1,D3
			      
			MOVE.L  D2,D4
       		ADD.L	#1,D4
			MOVE.B	#87,D0
			TRAP #15
			MOVEM.L (A7)+,D3/D4/D5
NOPAINT			
			ADD.L	D5,D4
			ADDQ.L	#1,D4
			CMP.W D4,D6
			BEQ HEIGHT_CHECK2
			BNE NEXT2
HEIGHT_CHECK2
			ADDQ.W #1,D3
			BRA	HEIGHT2
			
FINAL2  			RTS





